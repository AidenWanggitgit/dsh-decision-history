{
  "name": "@local/decision-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Auditable decision trail: records why a path was chosen or dropped, with a verbatim/inferred/missing honesty label and replayable evidence coordinates.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
